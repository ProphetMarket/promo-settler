# Copy to .env, fill in every value, and load it with: set -a; source .env; set +a
# DEPLOYMENT.md lists the values per chain and the checks to run after the deploy.

# ── Read by script/Deploy.s.sol ───────────────────────────────────────────────

# ProphetCTFExchange. The settler reads USDC and the Conditional Tokens address from it.
# Polygon mainnet: 0x127aD3A6e55EbBDaecC0eaeb12615879611e1839
# Polygon Amoy:    0x0D9BD7320985ee23c04885Ec93f6c118a83c7ec0
EXCHANGE_ADDRESS=0x0000000000000000000000000000000000000000

# The promo wallet EOA: the server's PROMO_ADDRESS, controlled by KMS_PROMO_KEY_ID.
# It funds every credit and receives every recovered token. It can never change after the deploy.
PROMO_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# The first settler admin (NOT a private key). Use the wallet that administers the exchange.
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# The first settler operator (NOT a private key): the server's OPERATOR_ADDRESS, which the
# exchange already lists as an operator.
OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000

# The first credit maximum, in USDC raw units (1000000 = $1.00). Use the largest credit the
# first campaign grants. The admin changes it later with setMaxCreditUnits, with no redeploy.
MAX_CREDIT_UNITS=

# ── Read by script/DeployLocal.s.sol (local Anvil only) ──────────────────────

# The local addresses file, set by the server's contracts/Makefile.
# ADDRESSES_JSON_PATH=../../addresses.json
# The TestUSDC minted to the promo wallet and approved to the settler ($100.00).
# LOCAL_PROMO_FUND_UNITS=100000000

# ── Used by the commands in DEPLOYMENT.md (not read by a script) ──────────────

RPC_URL=
DEPLOYER_ADDRESS=
DEPLOYER_ACCOUNT=
ETHERSCAN_API_KEY=
